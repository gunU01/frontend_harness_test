rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /config/{uid} {
      allow read, write: if request.auth.uid == uid;
    }
    match /specs/{specId} {
      allow read: if resource.data.published == true || (request.auth != null && request.auth.uid == resource.data.uid);
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
      allow update: if request.auth != null && request.auth.uid == resource.data.uid && request.resource.data.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }
    match /events/{eventId} {
      // append-only 로그: 생성만 허용하고, 소유자라도 과거 이벤트를 고치거나 지울 수 없다.
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow update, delete: if false;
    }
  }
}
