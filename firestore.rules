rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /config/{uid} {
      allow read, write: if request.auth.uid == uid;
    }
    match /specs/{specId} {
      allow read: if resource.data.published == true || (request.auth != null && request.auth.uid == resource.data.uid);
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
      allow update: if request.auth != null && request.auth.uid == resource.data.uid && request.resource.data.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }
  }
}
